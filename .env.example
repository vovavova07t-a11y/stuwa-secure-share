# ==========================================================
# Конфигурация окружения портала STUWA
# Скопируйте этот файл в .env (локально) или задайте переменные
# в панели Plesk: Хостинг -> Node.js / Переменные окружения,
# либо перед сборкой: `VITE_API_URL=... npm run build`
# ВАЖНО: переменные VITE_* подставляются во время сборки (build).
# ==========================================================

# --- Бэкенд / база данных ---
# Адрес нашего API (self-hosted Supabase или собственный бэкенд к PostgreSQL)
VITE_API_URL=https://api.stuwa.kz
# Альтернативное имя переменной (используется, если VITE_API_URL не задан)
VITE_DB_URL=https://api.stuwa.kz
# Публичный (anon) ключ API. Для собственного бэкенда без JWT можно оставить пустым.
VITE_API_KEY=

# --- Файловое хранилище ---
# server   -> файлы хранятся на нашем сервере по относительным путям
# supabase -> облачные бакеты Supabase Storage
VITE_STORAGE_MODE=server
# Публичный путь для чтения файлов (папка на хостинге Plesk)
VITE_STORAGE_PUBLIC_URL=/uploads
# Эндпоинт бэкенда для загрузки (POST) и удаления (DELETE) файлов
VITE_STORAGE_UPLOAD_URL=/api/uploads

# --- Совместимость (legacy, можно не заполнять при собственном бэкенде) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
